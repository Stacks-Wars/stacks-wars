# ==============================
# Backend API Connection
# ==============================
# The HTTP URL of the backend API server.
NEXT_PUBLIC_HTTP_URL=http://localhost:3001

# The WebSocket URL of the backend server (used for real-time lobby/game communication).
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ==============================
# Stacks Network
# ==============================
# The Stacks blockchain network: "mainnet" or "testnet"
NEXT_PUBLIC_NETWORK="mainnet"

# ==============================
# Trusted Signer Key
# ==============================
# A BIP39 mnemonic passphrase used to derive the private key that signs game results.
# The corresponding public key must be set as TRUSTED-PUBLIC-KEY in each vault contract.
#
# To generate the public key from this passphrase, run:
#
#   import { generateWallet } from "@stacks/wallet-sdk";
#   import { privateKeyToPublic } from "@stacks/transactions";
#
#   const wallet = await generateWallet({ secretKey: "<your passphrase>", password: "" });
#   const publicKey = privateKeyToPublic(wallet.accounts[0].stxPrivateKey);
#   console.log(`0x${publicKey}`);
#
# Then update the TRUSTED-PUBLIC-KEY constant in each contract:
#   - contracts/stx-vault.clar
#   - contracts/ft-vault.clar
#   - contracts/sponsored-stx-vault.clar
#   - contracts/sponsored-ft-vault.clar
TRUSTED_SECRET_KEY=

# ==============================
# Hiro API (Optional)
# ==============================
# API key for Hiro's Stacks API, used for on-chain token lookups.
# Get your key at https://www.hiro.so/blog/increase-your-api-rate-limits-with-an-api-key
HIRO_API_KEY=