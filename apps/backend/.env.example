# ==============================
# Redis Connection
# ==============================
# Redis is used for real-time lobby state, player state, and WebSocket pub/sub.
# Get a free Redis database at https://cloud.redis.io/#/databases
# Or run a local Redis instance: redis://127.0.0.1:6379
REDIS_URL=

# ==============================
# PostgreSQL Database
# ==============================
# PostgreSQL stores users, lobbies, games, seasons, leaderboards, and wars points.
# Get a free serverless Postgres database at https://neon.tech
# Connection string format: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ==============================
# Authentication
# ==============================
# Secret key used to sign and verify JWT tokens for user authentication.
# Use a strong random string in production.
JWT_SECRET="stacks_wars_deep_and_hidden_secret"

# How many days a JWT token remains valid before requiring re-authentication.
TOKEN_EXPIRY_DAYS="14"

# ==============================
# Server Configuration
# ==============================
# The port the backend HTTP/WebSocket server listens on.
PORT="3001"

# Stacks blockchain network: "mainnet" or "testnet"
NETWORK="mainnet"

# Comma-separated list of allowed CORS origins for the frontend.
ALLOWED_ORIGINS="https://stackswars.com,https://www.stackswars.com,https://test.stackswars.com,http://localhost:4002"

# Runtime environment: "development" or "production"
# Development enables additional logging and relaxed checks.
ENVIRONMENT="development"

# ==============================
# Admin Configuration
# ==============================
# Comma-separated Stacks wallet addresses with admin privileges.
# Admins can create games via the platform.
ADMIN_WALLETS="your wallet address"

# ==============================
# Hiro API
# ==============================
# API key for Hiro's Stacks API (used for on-chain verification and token lookups).
# Get your API key at https://www.hiro.so/blog/increase-your-api-rate-limits-with-an-api-key
HIRO_API_KEY=

# ==============================
# Telegram Bot (Optional)
# ==============================
# Used to send lobby creation notifications to a Telegram group.
# Create a bot via @BotFather on Telegram to get the token.
# The chat ID is the target group/channel ID (negative for groups).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=